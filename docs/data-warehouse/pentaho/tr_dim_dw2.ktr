  <step>
    <name>in_dim_buku_ulasan</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>src_sumber</connection>
    <sql>SELECT b.book_id,
       b.title AS judul,
       COALESCE(
         LEFT(GROUP_CONCAT(a.author_name ORDER BY ba.urutan SEPARATOR ', '), 255),
         'Tidak diketahui'
       ) AS penulis,
       b.publisher AS penerbit,
       CAST(b.publication_year AS UNSIGNED) AS tahun_terbit,
       COALESCE(c.category_name, 'Tanpa Kategori') AS nama_kategori
FROM basdat_sumber.books b
LEFT JOIN basdat_sumber.categories c ON c.category_id = b.category_id
LEFT JOIN basdat_sumber.book_authors ba ON ba.book_id = b.book_id
LEFT JOIN basdat_sumber.authors a ON a.author_id = ba.author_id
GROUP BY b.book_id, b.title, b.publisher, b.publication_year, c.category_name</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
