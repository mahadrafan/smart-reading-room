		<table name="reviews" row_count="0" spec="" >
			<column name="review_id" type="INT" length="11" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="user_id" type="INT" length="11" mandatory="y" />
			<column name="book_id" type="INT" length="11" mandatory="y" />
			<column name="rating" type="INT" length="11" />
			<column name="review_text" type="TEXT" />
			<column name="created_at" type="DATETIME" >
				<defo><![CDATA[current_timestamp()]]></defo>
			</column>
			<index name="pk_reviews" unique="PRIMARY_KEY" >
				<column name="review_id" />
			</index>
			<index name="user_id" unique="NORMAL" >
				<column name="user_id" />
			</index>
			<index name="book_id" unique="NORMAL" >
				<column name="book_id" />
			</index>
			<constraint name="cns_reviews_rating" >
				<string><![CDATA[`rating` between 1 and 5]]></string>
			</constraint>
			<fk name="reviews_ibfk_1" to_schema="basdat" to_table="users" options="" >
				<fk_column name="user_id" pk="user_id" />
