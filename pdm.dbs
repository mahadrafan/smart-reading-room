			<column name="stock" type="INT" length="11" >
				<defo><![CDATA[0]]></defo>
			</column>
			<column name="available_stock" type="INT" length="11" >
				<defo><![CDATA[0]]></defo>
			</column>
			<index name="pk_books" unique="PRIMARY_KEY" >
				<column name="book_id" />
			</index>
			<index name="category_id" unique="NORMAL" >
				<column name="category_id" />
			</index>
			<index name="author_id" unique="NORMAL" >
				<column name="author_id" />
			</index>
			<fk name="books_ibfk_1" to_schema="basdat" to_table="categories" options="" >
				<fk_column name="category_id" pk="category_id" />
			</fk>
			<fk name="books_ibfk_2" to_schema="basdat" to_table="authors" options="" >
				<fk_column name="author_id" pk="author_id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci]]></options>
		</table>
		<table name="categories" row_count="0" spec="" >
			<column name="category_id" type="INT" length="11" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
