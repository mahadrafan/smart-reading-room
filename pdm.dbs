<project name="MySql" database="MySql" id="935adab0-27eb-40be-a734-fec1711e63fb" >
	<schema name="basdat" >
		<table name="authors" row_count="0" spec="" >
			<column name="author_id" type="INT" length="11" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="author_name" type="VARCHAR" length="100" mandatory="y" />
			<column name="biography" type="TEXT" />
			<index name="pk_authors" unique="PRIMARY_KEY" >
				<column name="author_id" />
			</index>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci]]></options>
		</table>
		<table name="books" row_count="0" spec="" >
			<column name="book_id" type="INT" length="11" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="category_id" type="INT" length="11" />
			<column name="author_id" type="INT" length="11" />
			<column name="title" type="VARCHAR" length="200" mandatory="y" />
