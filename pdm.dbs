		<table name="users" row_count="0" spec="" >
			<column name="user_id" type="INT" length="11" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="role" type="ENUM" mandatory="y" >
				<enumeration><![CDATA['User','Admin']]></enumeration>
			</column>
			<column name="nim_nip" type="VARCHAR" length="20" />
			<column name="name" type="VARCHAR" length="100" mandatory="y" />
			<column name="class" type="VARCHAR" length="20" />
			<column name="email" type="VARCHAR" length="100" mandatory="y" />
			<column name="password" type="VARCHAR" length="255" mandatory="y" />
			<column name="phone" type="VARCHAR" length="20" />
			<column name="created_at" type="DATETIME" >
				<defo><![CDATA[curtime()]]></defo>
			</column>
			<index name="pk_users" unique="PRIMARY_KEY" >
				<column name="user_id" />
			</index>
			<index name="email" unique="UNIQUE_KEY" >
				<column name="email" />
			</index>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci]]></options>
		</table>
