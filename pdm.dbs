			<column name="publisher" type="VARCHAR" length="100" />
			<column name="publication_year" type="YEAR" length="4" />
			<column name="description" type="TEXT" />
			<column name="file_url" type="VARCHAR" length="255" />
			<column name="access_status" type="VARCHAR" length="20" />
